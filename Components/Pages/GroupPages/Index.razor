@page "/groups"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy2.Models
@using Academy2.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Academy2.Data.Academy2Context> DbFactory

<PageTitle>Группы</PageTitle>

<div class="controls mb-3">
    <div>
        <h1>Группы</h1>
        <p>
            <a href="groups/create" class="btn btn-primary">Create New</a>
        </p>
    </div>

    
    <div>
        <label for="items-per-page">Элементов на странице:</label>
        <select id="items-per-page" @bind="pagination.ItemsPerPage" class="form-control d-inline ms-2" style="width: auto;">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
    </div>
    
</div>

<div>
    <div class="grid-container">
        
        <QuickGrid Class="table" 
                  Items="context.Groups.Include(g => g.Direction)" 
                  Pagination="pagination"
                  SortBy="sortBy">
            
            <PropertyColumn Property="g => g.group_name" Title="Название группы" Sortable="true" Class="group-name" />
            <PropertyColumn Property="g => g.learning_days" Title="Дни обучения" Class="learning-days" />
            <PropertyColumn Property="g => g.start_time" Title="Время начала" Class="start-time" />
            <PropertyColumn Property="g => g.start_date" Title="Дата начала" Class="start-date" />

            <TemplateColumn Title="Действия" Align="Align.Center">
                <a href="@($"groups/edit?group_id={context.group_id}")">Edit</a> |
                <a href="@($"groups/details?group_id={context.group_id}")">Details</a> |
                <a href="@($"groups/delete?group_id={context.group_id}")">Delete</a>
            </TemplateColumn>
        </QuickGrid>
    </div>

    <Paginator State="pagination" />
</div>

@code {
    private Academy2Context context = default!;

    // Дефолтная сортировка: по названию группы
    GridSort<Group> sortBy = GridSort<Group>.ByAscending(g => g.group_name);

    // Пагинация
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
        {
            await context.DisposeAsync();
        }
    }
}